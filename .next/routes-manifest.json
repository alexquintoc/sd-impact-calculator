{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/baselines/[slug]",
      "regex": "^/baselines/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/baselines/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/demo/blog/[filename]",
      "regex": "^/demo/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfilename": "nxtPfilename"
      },
      "namedRegex": "^/demo/blog/(?<nxtPfilename>[^/]+?)(?:/)?$"
    },
    {
      "page": "/projects/[slug]",
      "regex": "^/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/projects/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/updates/[slug]",
      "regex": "^/updates/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/updates/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/baselines",
      "regex": "^/baselines(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/baselines(?:/)?$"
    },
    {
      "page": "/footprints",
      "regex": "^/footprints(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/footprints(?:/)?$"
    },
    {
      "page": "/projects",
      "regex": "^/projects(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/projects(?:/)?$"
    },
    {
      "page": "/updates",
      "regex": "^/updates(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/updates(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/demo/blog/[filename]",
      "routeKeys": {
        "nxtPfilename": "nxtPfilename"
      },
      "dataRouteRegex": "^/_next/data/OAUxjbhVL6Fj_HUe9vQY0/demo/blog/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/OAUxjbhVL6Fj_HUe9vQY0/demo/blog/(?<nxtPfilename>[^/]+?)\\.json$"
    }
  ],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}